{
  "overrides": {
    "graceful-fs": "^4.2.11"
  },
  "name": "slawinsky-boilerplate",
  "version": "1.0.0",
  "description": "core",
  "main": "webpack.config.js",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.3",
    "browser-sync": "^2.29.3",
    "browser-sync-webpack-plugin": "^2.4.0",
    "chokidar": "^4.0.3",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "cssnano": "^6.0.1",
    "dotenv": "^17.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "playwright-core": "^1.55.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "sass": "^1.69.2",
    "sass-loader": "^13.3.2",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^6.1.1",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.2%"
  ],
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "scripts": {
    "start": "./dev.sh",
    "dev": "./dev.sh",
    "dev:sync": "./dev-sync.sh",
    "dev:watch": "cross-env NODE_ENV=development npx webpack --mode=development --watch",
    "dev:full": "concurrently --kill-others --prefix-colors \"cyan,magenta\" --prefix \"[{name}]\" \"npm run dev:watch\" \"npm run watch:php\"",
    "watch:php": "node scripts/watch-php.js",
    "browsersync": "cross-env NODE_ENV=development node scripts/browsersync.js",
    "build": "cross-env NODE_ENV=production npx webpack --mode=production",
    "build:dev": "cross-env NODE_ENV=development npx webpack --mode=development",
    "factory:init": "node scripts/factory/init-project.js",
    "factory:autopilot": "node scripts/factory/autopilot/run.js",
    "factory:autopilot:status": "node scripts/factory/autopilot/run.js status",
    "factory:autopilot:resume": "node scripts/factory/autopilot/run.js resume",
    "factory:autopilot:stop": "node scripts/factory/autopilot/run.js stop",
    "factory:autopilot:check": "node scripts/factory/autopilot/run.js check",
    "factory:qa:visual": "node scripts/factory/autopilot/visual.js",
    "factory:wp": "node scripts/factory/autopilot/wp.js",
    "factory:context": "node scripts/factory/generate-context.js",
    "factory:validate": "node scripts/factory/validate-factory.js",
    "factory:figma:prepare": "node scripts/factory/figma/prepare-snapshot.js",
    "factory:figma:validate": "node scripts/factory/figma/validate-snapshot.js",
    "factory:figma:status": "node scripts/factory/figma/snapshot-status.js",
    "factory:figma:section": "node scripts/factory/figma/section-status.js",
    "factory:qa": "node scripts/factory/qa/run-qa.js",
    "serve": "cross-env NODE_ENV=development npx webpack serve --mode=development",
    "clean": "rm -rf dist/*",
    "reset-env": "./reset-env.sh",
    "fix-env": "unset NODE_ENV && npm install --include=dev"
  },
  "author": "slawinsky",
  "license": "ISC",
  "bugs": {
    "url": "https://slawinsky.pl"
  },
  "homepage": "https://slawinsky.pl",
  "dependencies": {
    "@fontsource/dm-sans": "5.2.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fullcalendar/core": "^6.1.18",
    "@fullcalendar/daygrid": "^6.1.18",
    "@fullcalendar/interaction": "^6.1.18",
    "@fullcalendar/list": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.18",
    "aos": "^2.3.4",
    "postcss-cli": "^10.1.0",
    "swiper": "^11.2.10"
  }
}
