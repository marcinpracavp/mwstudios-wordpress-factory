{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mwstudios.pl/website-factory/schemas/figma-components.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nodeId", "name", "type", "variants", "usedByPages", "usedBySections"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "nodeId": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "minLength": 1 },
      "variants": { "type": "array" },
      "usedByPages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
      "usedBySections": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
    }
  }
}
