{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mwstudios.pl/website-factory/schemas/capabilities.schema.json",
  "title": "MWStudios Website Factory capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "factoryVersion",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/capabilities.schema.json"
    },
    "factoryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "required",
          "dependencies",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": [
              "core",
              "integration",
              "frontend",
              "feature"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
