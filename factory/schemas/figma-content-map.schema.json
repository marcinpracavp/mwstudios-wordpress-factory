{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mwstudios.pl/website-factory/schemas/figma-content-map.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["page", "section", "fieldIntent", "type", "languages", "source", "backendIntent"],
    "properties": {
      "page": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "section": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "fieldIntent": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "minLength": 1 },
      "languages": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$" },
        "additionalProperties": {}
      },
      "source": { "type": "string", "minLength": 1 },
      "backendIntent": { "type": "string", "minLength": 1 }
    }
  }
}
