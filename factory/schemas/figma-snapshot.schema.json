{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mwstudios.pl/website-factory/schemas/figma-snapshot.schema.json",
  "title": "MWStudios Website Factory Figma snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotVersion",
    "status",
    "source",
    "capturedAt",
    "pages",
    "frames",
    "sections",
    "languages",
    "viewports",
    "globalEffects",
    "warnings"
  ],
  "properties": {
    "snapshotVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["prepared", "partial", "complete"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "figmaUrl"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9]+$" },
        "figmaUrl": { "type": "string", "pattern": "^https://(?:www\\.)?figma\\.com/" }
      }
    },
    "capturedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "pages": { "type": "array", "items": { "$ref": "#/definitions/figmaPage" } },
    "frames": { "type": "array", "items": { "$ref": "#/definitions/frame" } },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/section" } },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/language" }
    },
    "viewports": { "type": "array", "items": { "$ref": "#/definitions/viewport" } },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/referencePath" }
        }
      }
    },
    "globalEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "affectedPages",
          "affectedSections",
          "description",
          "sourceNodeId",
          "implementationNotes"
        ],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "affectedPages": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/id" }
          },
          "affectedSections": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/id" }
          },
          "description": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": "string", "minLength": 1 },
          "implementationNotes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$" },
    "referencePath": { "type": "string", "minLength": 1, "pattern": "^(?!/).+\\.png$" },
    "figmaPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "PAGE" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "pageId", "type"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "viewport": { "type": "string", "minLength": 1 },
        "language": { "$ref": "#/definitions/language" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "order",
        "sitePageId",
        "figmaPageId",
        "snapshot",
        "desktopNodeId",
        "mobileNodeId",
        "desktopReference",
        "mobileReference"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "sitePageId": { "$ref": "#/definitions/id" },
        "figmaPageId": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "pattern": "^sections/.+\\.json$" },
        "desktopNodeId": { "type": "string", "minLength": 1 },
        "mobileNodeId": { "type": ["string", "null"], "minLength": 1 },
        "desktopReference": { "$ref": "#/definitions/referencePath" },
        "mobileReference": {
          "oneOf": [
            { "$ref": "#/definitions/referencePath" },
            { "type": "null" }
          ]
        },
        "variants": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/language" },
          "additionalProperties": { "$ref": "#/definitions/sectionVariant" }
        }
      }
    },
    "sectionVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktopNodeId", "desktopReference"],
      "properties": {
        "desktopNodeId": { "type": "string", "minLength": 1 },
        "mobileNodeId": { "type": ["string", "null"], "minLength": 1 },
        "desktopReference": { "$ref": "#/definitions/referencePath" },
        "mobileReference": {
          "oneOf": [
            { "$ref": "#/definitions/referencePath" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
